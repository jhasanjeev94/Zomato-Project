# ─── Groq API ───────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
MAX_TOKENS=2048

# ─── Zomato Scraping ────────────────────────────────
SCRAPE_CACHE_TTL_HOURS=6
MAX_PAGES_PER_CITY=5

# ─── Server ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ─── Filtering ──────────────────────────────────────
MAX_CANDIDATES=15

# ─── Deployment ─────────────────────────────────────
# Set this to your Vercel frontend URL to lock down CORS in production.
# Leave empty to allow all origins (development mode).
FRONTEND_URL=https://your-project.vercel.app
